{
  "manifest_version": 3,
  "name": "Claude Notify",
  "version": "1.0.0",
  "description": "Desktop notifications when Claude on claude.ai finishes responding or needs your input.",
  "permissions": ["notifications"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
